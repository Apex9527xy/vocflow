# Public HTTPS URL compiled into the desktop application.
VOCFLOW_PUBLIC_URL=https://api.example.com
VOCFLOW_CLOUD_HOST=127.0.0.1
VOCFLOW_CLOUD_PORT=8787
VOCFLOW_CLOUD_DATA_DIR=/var/lib/vocflow-cloud
VOCFLOW_CLOUD_DATA_FILE=/var/lib/vocflow-cloud/vocflow-cloud.json
VOCFLOW_BACKUP_DIR=/var/lib/vocflow-cloud/backups
VOCFLOW_BACKUP_INTERVAL_MS=900000
VOCFLOW_BACKUP_RETENTION=48
VOCFLOW_TRUST_PROXY=1

# Required before the first production start. Use a real mailbox and a unique
# random password of at least 16 characters. Never commit the filled file.
VOCFLOW_ADMIN_EMAIL=
VOCFLOW_ADMIN_PASSWORD=
VOCFLOW_ALLOW_FIRST_USER_ADMIN=0
