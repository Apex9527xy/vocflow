# Required: use your real DNS name. Never use example.com in production.
VOCFLOW_DOMAIN=cloud.example.com
VOCFLOW_PUBLIC_URL=https://cloud.example.com

# Required in production: fill in BOTH values with a real mailbox and a unique
# random password of at least 16 characters before the first start.
# The production service refuses to start while these values are blank.
VOCFLOW_ADMIN_EMAIL=
VOCFLOW_ADMIN_PASSWORD=

# Production must keep this disabled.
VOCFLOW_ALLOW_FIRST_USER_ADMIN=0

# Only enable this when the service is reachable exclusively through a trusted reverse proxy.
VOCFLOW_TRUST_PROXY=1

# Automatic data snapshots. Keep these under the persistent /app/data volume.
VOCFLOW_BACKUP_DIR=/app/data/backups
VOCFLOW_BACKUP_INTERVAL_MS=900000
VOCFLOW_BACKUP_RETENTION=48

PORT=8787
